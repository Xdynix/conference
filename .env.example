# =============================================================================
# Docker Compose Infrastructure
# =============================================================================
# These variables are consumed by docker-compose.yml interpolation.
# See .agents/DEPLOYMENT.md for the full deployment guide.

# Hostname for nginx-proxy service discovery (e.g., example.com).
VIRTUAL_HOST=example.com

# URL prefix when deploying under a subpath (e.g., /submission). Leave
# commented for root deployment. Must not have a trailing slash. Also
# uncomment VIRTUAL_PATH in the nginx service's environment block in
# docker-compose.yml when enabling this.
#VIRTUAL_PATH=

# Host directory mounted as the data volume (database, media, logs).
# Must be owned by UID 900 (see Dockerfile APP_UID):
#   mkdir -p var/media && chown -R 900:900 var
#HOST_DATA_DIR=./var

# Number of reverse proxies in front of the app (see "Reverse Proxy Count" in
# DEPLOYMENT.md). 0 = direct connection, 1 = sidecar nginx only (compose
# default), 2 = sidecar + upstream proxy (e.g., Cloudflare).
#REVERSE_PROXY_COUNT=1

# =============================================================================
# Security
# =============================================================================

# REQUIRED. A unique, unpredictable secret used for cryptographic signing.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Never enable in production.
#DEBUG=False

# =============================================================================
# Email (SMTP)
# =============================================================================
# The app queues mail via django-mailer and delivers through SMTP. Configure
# your SMTP provider here.

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
#EMAIL_USE_SSL=False
#EMAIL_TIMEOUT=60

# "From" address for outgoing emails.
DEFAULT_FROM_EMAIL=no-reply@example.com

# Prefix prepended to all email subjects (Django defaults to "[Django] ").
EMAIL_SUBJECT_PREFIX=

# =============================================================================
# Site
# =============================================================================

# Display name shown in the UI and emails.
SITE_NAME='My Conference'

# Emoji rendered as the default favicon.
#FAVICON_TEXT=💡

# =============================================================================
# Branding
# =============================================================================
# Optional logo and links shown in the site header.

#BRANDING_LOGO_URL=https://example.com/logo.png
#BRANDING_LOGO_ALT=My Conference
#BRANDING_LOGO_HEIGHT=40
#BRANDING_PARENT_URL=https://example.com
#BRANDING_FAVICON_URL=https://example.com/favicon.ico

# =============================================================================
# Cloudflare Turnstile
# =============================================================================
# CAPTCHA protection for public forms. Get keys from the Cloudflare dashboard.

# Mode: STRICT (always verify), LENIENT (verify but allow failures), or
# DISABLED (skip verification entirely). If not using Turnstile, set to
# DISABLED and leave the keys empty.
#CF_TURNSTILE_MODE=STRICT

CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# =============================================================================
# Logging and Monitoring
# =============================================================================

# Directory for log files. Leave empty to log to stdout only.
#LOG_DIR=

# Sentry DSN for error tracking. Leave empty to disable.
#SENTRY_DSN=

# =============================================================================
# Backup (Optional)
# =============================================================================
# Optional disaster recovery for the SQLite database (Litestream) and media
# files (rclone) to Cloudflare R2. Both sidecars share these credentials.
#
# To enable, add to .env:
#   COMPOSE_PROFILES=backup
#
# Then fill in the values below and restart the stack.

#BACKUP_S3_BUCKET=
#BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
#BACKUP_S3_ACCESS_KEY_ID=
#BACKUP_S3_SECRET_ACCESS_KEY=

# Interval between rclone media syncs, in seconds (default: 21600 = 6 hours).
#BACKUP_MEDIA_INTERVAL=21600

# =============================================================================
# Reverse Proxy (Advanced)
# =============================================================================
# These settings fine-tune IP resolution and request ID tracking when behind
# additional proxies beyond the sidecar nginx.

# Comma-separated list of trusted origins for CSRF validation (scheme + host
# + port). Required when the external origin includes a non-standard port or
# otherwise differs from what Django reconstructs via the Host header.
# Example: https://example.com:8443,https://example.com
#CSRF_TRUSTED_ORIGINS=

# Comma-separated ordered list of headers for client IP resolution.
# Example for Cloudflare: CF-Connecting-IP,X-Forwarded-For
#REVERSE_PROXY_IP_HEADERS=

# Adopt an upstream request ID instead of generating one.
#REVERSE_PROXY_REQUEST_ID_HEADER=
