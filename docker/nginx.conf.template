# Sidecar nginx for the app.
#
# Template variables (substituted by envsubst at container start):
#   APP_PORT  - port the app container listens on (e.g. 8000)
#   SUBPATH   - URL prefix, empty for root or "/my-app" style
#
# Hardcoded values that must match docker-compose.yml:
#   "app"     - upstream hostname (compose service name)
#   /media/   - media volume mount path in this container

upstream app {
    server app:${APP_PORT};
    keepalive 16;
}

# Redirect bare subpath to subpath with trailing slash. For root deployment
# (empty SUBPATH) the map matches "" which no real URI ever equals, so the
# redirect is a safe no-op.
map $uri $subpath_redirect {
    "${SUBPATH}" "${SUBPATH}/";
}

server {
    listen 80;
    server_tokens off;
    absolute_redirect off;

    client_max_body_size 256m;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    # Nginx-only healthcheck; not proxied to the app so each container's
    # health status stays independent.
    location = /_ping {
        access_log off;
        return 200;
    }

    # Serves media files on behalf of the app (X-Accel-Redirect).
    location /internal-media/ {
        internal;
        alias /media/;
    }

    if ($subpath_redirect) {
        return 302 $subpath_redirect$is_args$args;
    }

    location ${SUBPATH}/ {
        proxy_pass http://app/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
    }
}
